rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rolePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function ownerPath() {
      return /databases/$(database)/documents/_system/owner;
    }

    function isLegacyOwner() {
      return signedIn()
        && exists(ownerPath())
        && get(ownerPath()).data.uid == request.auth.uid;
    }

    function hasAdminRole() {
      return signedIn()
        && exists(rolePath(request.auth.uid))
        && get(rolePath(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return hasAdminRole() || isLegacyOwner();
    }

    function workspaceUid() {
      return exists(ownerPath()) ? get(ownerPath()).data.uid : request.auth.uid;
    }

    function customerEmailMatches(value) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && value is string
        && value.lower() == request.auth.token.email.lower();
    }

    function linkedCustomer(userId, clientId) {
      let clientPath = /databases/$(database)/documents/users/$(userId)/clients/$(clientId);
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(clientPath)
        && get(clientPath).data.linkedAuthUid == request.auth.uid;
    }

    function isCustomerOrderId(saleId) {
      return signedIn()
        && saleId.matches('^site_' + request.auth.uid + '_[A-Fa-f0-9-]{36}$');
    }

    function validCustomerOrder(userId) {
      let clientId = request.resource.data.clientId;
      let clientPath = /databases/$(database)/documents/users/$(userId)/clients/$(clientId);
      let sale = request.resource.data;
      return signedIn()
        && request.auth.token.email_verified == true
        && userId == workspaceUid()
        && sale.keys().hasOnly([
          'source', 'channel', 'status', 'orderApprovalStatus', 'scheduledPurchase', 'inventoryApplied',
          'clientId', 'client', 'items', 'soldAt', 'total', 'discount', 'fees', 'extraAmount',
          'receivedAmount', 'outstandingAmount', 'paymentStatus', 'paymentMethod', 'deliveryMethod',
          'delivery', 'deliveryStatus', 'productionStatus', 'orderType', 'notes', 'customerAuthUid',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && sale.keys().hasAll([
          'source', 'channel', 'status', 'orderApprovalStatus', 'scheduledPurchase', 'inventoryApplied',
          'clientId', 'client', 'items', 'soldAt', 'total', 'discount', 'fees', 'extraAmount',
          'receivedAmount', 'outstandingAmount', 'paymentStatus', 'paymentMethod', 'deliveryMethod',
          'delivery', 'deliveryStatus', 'productionStatus', 'orderType', 'notes', 'customerAuthUid',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && clientId is string
        && clientId.matches('^[A-Za-z0-9_-]{1,150}$')
        && exists(clientPath)
        && get(clientPath).data.linkedAuthUid == request.auth.uid
        && sale.customerAuthUid == request.auth.uid
        && sale.client.email is string
        && customerEmailMatches(sale.client.email)
        && sale.source == 'website'
        && sale.channel == 'website'
        && sale.status == 'active'
        && sale.orderApprovalStatus == 'pending'
        && sale.inventoryApplied == false
        && sale.scheduledPurchase is bool
        && sale.items is list
        && sale.items.size() > 0
        && sale.items.size() <= 30
        && sale.total is number
        && sale.total >= 0
        && sale.total <= 50000
        && sale.discount == 0
        && sale.fees == 0
        && sale.extraAmount == 0
        && sale.receivedAmount == 0
        && sale.outstandingAmount == sale.total
        && sale.paymentStatus == 'pending'
        && sale.paymentMethod == 'outro'
        && sale.deliveryMethod == 'delivery'
        && sale.delivery is map
        && sale.deliveryStatus == 'pending'
        && sale.productionStatus == 'not_started'
        && sale.orderType == 'physical'
        && sale.notes is string
        && sale.notes.size() <= 1000
        && sale.soldAt is string
        && sale.soldAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && sale.createdBy == 'website-customer'
        && sale.createdAt is timestamp
        && sale.updatedAt is timestamp;
    }

    function validPublicProduct() {
      return request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'price', 'photo', 'hasInventory', 'quantity', 'inStock', 'published', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'category', 'price', 'photo', 'hasInventory', 'quantity', 'inStock', 'published', 'updatedAt'
        ])
        && request.resource.data.published == true
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 700
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.photo is string
        && request.resource.data.hasInventory is bool
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.inStock is bool
        && request.resource.data.photo.size() <= 600000;
    }

    // Preserve access for the administrator registered by the old setup flow.
    match /_system/owner {
      allow get: if !exists(ownerPath()) || hasAdminRole() || isLegacyOwner();
      allow list, create, update, delete: if false;
    }

    // Product quantity is public by storefront request; costs and customer
    // records remain private.
    match /siteContent/{document} {
      allow read: if document == 'main';
      allow write: if isAdmin();
    }
    match /publicSiteProducts/{productId} {
      allow read: if resource.data.published == true;
      allow create, update: if isAdmin() && validPublicProduct();
      allow delete: if isAdmin();
    }
    match /publicInstagramPosts/{postId} {
      allow read: if resource.data.published == true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'caption', 'type', 'image', 'url', 'timestamp', 'published', 'syncedAt'])
        && request.resource.data.published == true;
      allow delete: if isAdmin();
    }

    // Each signed-in user can read their own role. Only a trusted Firebase
    // Console operator or Admin SDK process can assign roles.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;

      // Profile and appearance settings stay private to each admin. Payment
      // and business-document settings are shared across the workspace.
      match /settings/{settingId} {
        allow read, write: if isAdmin() && (
          request.auth.uid == userId
          || (workspaceUid() == userId && settingId in ['payment', 'business'])
        );
      }

      match /clients/{clientId} {
        allow get, list: if isAdmin()
          || (signedIn() && request.auth.token.email_verified == true
            && (resource.data.linkedAuthUid == request.auth.uid
              || customerEmailMatches(resource.data.emailNormalized)
              || customerEmailMatches(resource.data.email)));
        allow update: if isAdmin()
          || (signedIn() && request.auth.token.email_verified == true
            && request.resource.data.linkedAuthUid == request.auth.uid
            && (customerEmailMatches(resource.data.emailNormalized)
              || customerEmailMatches(resource.data.email))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'email', 'emailNormalized', 'linkedAuthUid', 'linkedAt', 'updatedAt'
            ]));
        allow create, delete: if isAdmin();
      }

      match /externalSales/{saleId} {
        allow get: if isAdmin()
          || (isCustomerOrderId(saleId) && userId == workspaceUid())
          || (resource.data.customerAuthUid == request.auth.uid)
          || (resource.data.clientId is string && linkedCustomer(userId, resource.data.clientId));
        allow list: if isAdmin()
          || (signedIn() && request.auth.token.email_verified == true
            && (resource.data.customerAuthUid == request.auth.uid
              || (resource.data.clientId is string && linkedCustomer(userId, resource.data.clientId))));
        allow create: if isAdmin() || (isCustomerOrderId(saleId) && validCustomerOrder(userId));
        allow update, delete: if isAdmin();
      }

      // Business collections are shared through the original admin UID.
      match /{collection}/{document=**} {
        allow read, write: if isAdmin()
          && collection != 'settings'
          && workspaceUid() == userId;
      }
    }

    // Deny everything else unless a narrowly scoped rule is added later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
